//	bulletTrace along the 1.5 turret_ab round that ours stops on
//	mp_carentan's patches 133 and 136 (cod11-combat.md 3.6): the ray, rays
//	offset around it, the half past the gun and the reverse. Run by
//	tools/run_probe.sh on mp_carentan; no client needed.

main()
{
	maps\mp\gametypes\dm::main();
	thread probe();
}

probe()
{
	wait 1;
	s = (1712, 1831.3, 27.6);
	e = (1100, 1041.2, 7.6);
	m = (1450, 1493, 19);
	side = (-3.16, 2.45, 0);
	shot("ray", s, e);
	shot("up4", s + (0, 0, 4), e + (0, 0, 4));
	shot("up2", s + (0, 0, 2), e + (0, 0, 2));
	shot("down2", s - (0, 0, 2), e - (0, 0, 2));
	shot("down4", s - (0, 0, 4), e - (0, 0, 4));
	shot("left4", s + side, e + side);
	shot("right4", s - side, e - side);
	shot("near", m, e);
	shot("reverse", e, s);
	shot("drop", (1388, 1413, 100), (1388, 1413, -100));
	shot("drop2", (1380, 1400, 100), (1380, 1400, -100));
	shot("drop3", (1300, 1300, 100), (1300, 1300, -100));
	ms = (1706.721, 1822.8395, 28.679152);
	me = (-3318.5461, -4644.5234, -140.95471);
	shot("exact", ms, me);
	shot("lat-2", (1705.1420, 1824.0663, 28.6792), (-3320.1251, -4643.2966, -140.9547));
	shot("lat-1", (1705.9315, 1823.4529, 28.6792), (-3319.3356, -4643.9100, -140.9547));
	shot("lat-0.5", (1706.3263, 1823.1462, 28.6792), (-3318.9408, -4644.2167, -140.9547));
	shot("lat-0.3", (1706.4841, 1823.0235, 28.6792), (-3318.7829, -4644.3394, -140.9547));
	shot("lat-0.1", (1706.6420, 1822.9008, 28.6792), (-3318.6251, -4644.4621, -140.9547));
	shot("lat-0.03", (1706.6973, 1822.8579, 28.6792), (-3318.5698, -4644.5050, -140.9547));
	shot("lat0.03", (1706.7447, 1822.8211, 28.6792), (-3318.5224, -4644.5418, -140.9547));
	shot("lat0.1", (1706.8000, 1822.7782, 28.6792), (-3318.4671, -4644.5847, -140.9547));
	shot("lat0.3", (1706.9579, 1822.6555, 28.6792), (-3318.3093, -4644.7074, -140.9547));
	shot("lat0.5", (1707.1157, 1822.5328, 28.6792), (-3318.1514, -4644.8301, -140.9547));
	shot("lat1", (1707.5105, 1822.2261, 28.6792), (-3317.7566, -4645.1368, -140.9547));
	shot("lat2", (1708.3000, 1821.6127, 28.6792), (-3316.9671, -4645.7502, -140.9547));
	shot("vert-2", (1706.7210, 1822.8395, 26.6792), (-3318.5461, -4644.5234, -142.9547));
	shot("vert-1", (1706.7210, 1822.8395, 27.6792), (-3318.5461, -4644.5234, -141.9547));
	shot("vert-0.5", (1706.7210, 1822.8395, 28.1792), (-3318.5461, -4644.5234, -141.4547));
	shot("vert-0.3", (1706.7210, 1822.8395, 28.3792), (-3318.5461, -4644.5234, -141.2547));
	shot("vert-0.1", (1706.7210, 1822.8395, 28.5792), (-3318.5461, -4644.5234, -141.0547));
	shot("vert-0.03", (1706.7210, 1822.8395, 28.6492), (-3318.5461, -4644.5234, -140.9847));
	shot("vert0.03", (1706.7210, 1822.8395, 28.7092), (-3318.5461, -4644.5234, -140.9247));
	shot("vert0.1", (1706.7210, 1822.8395, 28.7792), (-3318.5461, -4644.5234, -140.8547));
	shot("vert0.3", (1706.7210, 1822.8395, 28.9792), (-3318.5461, -4644.5234, -140.6547));
	shot("vert0.5", (1706.7210, 1822.8395, 29.1792), (-3318.5461, -4644.5234, -140.4547));
	shot("vert1", (1706.7210, 1822.8395, 29.6792), (-3318.5461, -4644.5234, -139.9547));
	shot("vert2", (1706.7210, 1822.8395, 30.6792), (-3318.5461, -4644.5234, -138.9547));
	logPrint("PROBE done\n");
}

shot(name, from, to)
{
	t = bulletTrace(from, to, false, undefined);
	logPrint("PROBE " + name + " " + t["fraction"] + " " + t["position"] + " " + t["surfacetype"] + "\n");
}
