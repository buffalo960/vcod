//	bulletTrace along 790 segments across mp_carentan's lump 24 patches,
//	aimed at control points and the midpoints between them, where facets
//	meet (bsp-ibsp59-format.md, "Patch collision on 1.5 and UO"). Each line
//	prints the fraction and, against a base a little under it, the
//	difference times a million, which tells two floats a bit apart. Run by
//	tools/run_probe.sh on mp_carentan; no client needed. The segments are
//	crates/common/tests/fixtures/patch/mp_carentan-seams.txt's.

main()
{
	maps\mp\gametypes\dm::main();
	thread probe();
}

shot(i, from, to, base)
{
	t = bulletTrace(from, to, true, undefined);
	logPrint("PROBE s " + i + " " + t["fraction"] + " " + ((t["fraction"] - base) * 1000000) + "\n");
}

probe()
{
	wait 1;
	chunk0();
	wait 0.05;
	chunk1();
	wait 0.05;
	chunk2();
	wait 0.05;
	chunk3();
	wait 0.05;
	chunk4();
	wait 0.05;
	chunk5();
	wait 0.05;
	chunk6();
	wait 0.05;
	chunk7();
	wait 0.05;
	chunk8();
	wait 0.05;
	chunk9();
	wait 0.05;
	chunk10();
	wait 0.05;
	chunk11();
	wait 0.05;
	chunk12();
	wait 0.05;
	chunk13();
	wait 0.05;
	chunk14();
	wait 0.05;
	chunk15();
	wait 0.05;
	logPrint("PROBE done\n");
}

